# Supabase public values. These are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Supabase server-only value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Agent server.
# Used by the PMS to call /internal/* routes after manual doctor changes.
AGENT_URL=http://localhost:3000
INTERNAL_API_TOKEN=same_token_as_agent_env

# Comma-separated hosts allowed for Next server actions.
SERVER_ACTION_ALLOWED_ORIGINS=localhost:3001
